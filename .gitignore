__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
media/*.mp4
media/cam1_frame.jpg
media/*_frame.jpg
*.Zone.Identifier
*:Zone.Identifier

# Regenerated evidence artifacts.
#
# Ignore the directory and re-admit the few files that are PROOF rather than
# output. The previous list named specific subdirectories, so every new run
# created a new one that nothing covered — 64 loose files, 5.4 MB, all of it
# one `git add -A` away from the repo.
evidence/*
!evidence/README.md
!evidence/contact_sheet.jpg
!evidence/metrics.json
!evidence/cross_camera_eval.json
!evidence/cross_camera_eval_dense.json
!evidence/cc_eval_th070.json
!evidence/cc_eval_th078.json
!evidence/scenario_first_frame.jpg

# Local SQLite history db (regenerated at runtime)
data/

# Local tooling / logs (bootstrap + install helpers)
scripts/get-pip.py
scripts/*.log
scripts/logs/
# downloaded mediamtx RTSP server binary (scripts/rtsp_setup.sh) + its auto TLS certs
scripts/bin/
auto.crt
auto.key
# Locally generated API keys — never commit a live credential
.local_key
.local_integration_key
# systemd environment file: holds the live keys, chmod 600
.env

# Model weights — fetched via scripts/get_weights.py, not committed
models/*.pt

# Local Postgres test rig (scripts/pg_local_install.sh). .pgtest holds the
# server binaries pip fetched; .pgdata is a live cluster with real migrated
# data in it. Neither belongs in git — one is ~100 MB of vendored binaries,
# the other is a database.
.pgtest/
.pgdata/

# Static ffmpeg fetched by scripts/get_ffmpeg.sh — 80 MB binary, not source.
.tools/
evidence/rtsp_demo_frame.jpg
